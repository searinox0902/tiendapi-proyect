# Copia este archivo a `.env` y ajusta los valores.

# BBDD central (PostgreSQL). En local con Docker apunta a localhost;
# dentro de docker-compose el host es el nombre del servicio (`postgres`).
DATABASE_URL=postgresql+psycopg://tiendapi:tiendapi@localhost:5432/tiendapi

# development | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS: orígenes permitidos separados por coma (Vite dev + empaquetado Tauri).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost

# Secreto para la firma del token de sesión/JWT (auth real, fase F1).
# En producción: generar uno fuerte (p. ej. `openssl rand -hex 32`) y NUNCA commitearlo.
SECRET_KEY=dev-insecure-change-me
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=720
