# URL del backend en desarrollo (Docker local, docs/10). No es secreto: se
# versiona. Para overrides personales usa `.env.development.local` (gitignorado).
VITE_API_URL=http://localhost:8000

# Latencia artificial solo en dev, para ver spinners/skeletons contra un
# backend local que responde en pocos ms (D-54). 0 o vacío = sin delay.
VITE_FAKE_LATENCY_MS=0
